+    private static final Map<Camera, Camera1Player> sPlayers = new ConcurrentHashMap<>();
+
+    public static void startPreview(Camera camera, Surface surface, int width, int height) {
+        try {
+            if (!VcamLicenseVerifier.isLicenseActive()) return;
+            if (VcamConfig.isVcamDisabled()) return;
+
+            final File videoFile = VcamConfig.getActiveVideoFile();
+            if (videoFile == null || surface == null || !surface.isValid()) return;
+
+            stopPreview(camera);
+
+            Camera1Player player = new Camera1Player(videoFile, surface, width, height);
+            sPlayers.put(camera, player);
+            player.start();
+            Log.i(TAG, "Started Vcam Camera1Player for camera: " + camera);
+        } catch (Throwable t) {
+            Log.e(TAG, "startPreview error: " + t);
+        }
+    }
+
+    public static void stopPreview(Camera camera) {
+        if (camera == null) return;
+        Camera1Player player = sPlayers.remove(camera);
+        if (player != null) {
+            player.stop();
+            Log.i(TAG, "Stopped Vcam Camera1Player for camera: " + camera);
+        }
+    }
+
+    public static void release(Camera camera) {
+        stopPreview(camera);
+    }
